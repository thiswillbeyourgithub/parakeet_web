# Configuration for the parakeet OpenAI-like transcription API.
#
#   cp env.example .env      # then set MODEL_DIR (mandatory) and pick an auth mode
#   docker compose up -d --build
#
# Every PARAKEET_* variable below is also a CLI flag (`--help` lists both), and a
# CLI flag WINS over its env var. Values shown are the defaults, so a commented
# line and an absent line behave identically.
#
# MOST requests can override the decoding/boosting knobs per call (the `[field]`
# names in --help). Set PARAKEET_LOCK_PARAMS=true to forbid that.
#
# Built with Claude Code.

# ─────────────────────────────────────────────────────────────────────────────
# 1. REQUIRED: where the ONNX weights are, on the HOST
# ─────────────────────────────────────────────────────────────────────────────
# Must contain encoder-model.*.onnx + decoder_joint-model.*.onnx + vocab.txt.
# There is no runtime download: a missing/incomplete directory is a fatal boot
# error naming exactly what is missing. Get the weights with:
#   hf download Olicorne/parakeet-tdt-0.6b-v3-optimized-onnx --local-dir ./models
# For diarization, that directory also needs the two extra models (see section 8).
MODEL_DIR=./models

# Phrase-boost wordlists on the HOST (any .txt or .pwc; each becomes selectable by
# basename). Defaults to this repo's curated lists (french_medical, lorn).
#WORDLIST_DIR=../../phrase_boosting

# ─────────────────────────────────────────────────────────────────────────────
# 2. auth and exposure
# ─────────────────────────────────────────────────────────────────────────────
# Bearer token required on every request except /health. EMPTY = NO AUTH, and a
# keyless server also ACCEPTS any key a client sends (SDKs that refuse to start
# without an api_key can pass any placeholder; there is no secret to check it
# against). Once set, it is enforced regardless of the bind address.
#   openssl rand -hex 32
# Clients send it as `Authorization: Bearer <key>` (an `api-key:` header also works).
PARAKEET_API_KEY=

# The container binds 0.0.0.0 (a published port cannot reach a process on the
# container's own loopback), so a keyless server would be exposed to whatever can
# reach that port. The compose file publishes it to 127.0.0.1 ONLY, which makes
# keyless acceptable -- but you must say so explicitly:
#
#   PARAKEET_API_KEY set          -> leave this false (recommended)
#   keyless + loopback publish    -> set this true, and keep the publish loopback
#
# Set a key and remove this the moment you publish the port on a real interface.
# (This server speaks plain HTTP: put TLS in front of it before exposing it.)
PARAKEET_ALLOW_KEYLESS_NON_LOOPBACK=false

# Host port the API is published on (container side is always 8002).
#PARAKEET_PORT=8002

# Address the SERVER binds. The compose file pins this to 0.0.0.0 inside the
# container (see above); outside a container the default is 127.0.0.1 and binding
# anything else requires PARAKEET_API_KEY.
#PARAKEET_HOST=0.0.0.0

# Exact Origins allowed to call the API from a browser, comma-separated. Empty =
# emit no CORS headers at all (server-to-server use). "*" allows any origin.
#PARAKEET_ALLOWED_ORIGINS=

# Prefix every route (whisper.cpp compatible): /asr -> /asr/v1/audio/transcriptions
#PARAKEET_REQUEST_PATH=
# Path of the whisper.cpp-style alias route; set empty to disable it.
#PARAKEET_INFERENCE_PATH=/inference

# ─────────────────────────────────────────────────────────────────────────────
# 3. limits (denial-of-service surface)
# ─────────────────────────────────────────────────────────────────────────────
# Bodies larger than this get 413. Keep TMPFS_SIZE (section 10) above it.
#PARAKEET_MAX_UPLOAD_MB=100
# How many requests may WAIT while one transcribes (the model is single-instance
# and strictly FIFO). Beyond this: 429 + Retry-After. 0 = reject any overlap.
#PARAKEET_MAX_QUEUE=8
# Give up on a request (504) after this many seconds, queue wait included. Note an
# already-started decode cannot be cancelled, so it keeps running server-side.
#PARAKEET_REQUEST_TIMEOUT_SEC=1800

# ─────────────────────────────────────────────────────────────────────────────
# 4. model and runtime
# ─────────────────────────────────────────────────────────────────────────────
# In-container path. Change this only if you also change the volume mount.
#PARAKEET_MODEL_DIR=/models
# Architecture key (mel bins + subsampling), not the files.
#PARAKEET_MODEL=parakeet-tdt-0.6b-v3
# Model id reported by GET /v1/models. Defaults to "<model>-<quant>".
#PARAKEET_MODEL_ID=
# ENCODER precision. int8 is the ONLY one the wasm backend can load (a single
# ArrayBuffer caps at ~2 GB in 32-bit WASM and the CPU/WASM EP upcasts fp16 to
# fp32 at session build). For fp16/fp32 use PARAKEET_ORT=node.
#PARAKEET_QUANT=int8
# DECODER/joiner precision, chosen independently. int8 is as accurate as fp32 on
# this model while ~4x smaller.
#PARAKEET_DECODER_QUANT=int8
# wasm = vendored onnxruntime-web build; no native dependency, and byte-identical
#        to what the browser app runs (int8 only)
# node = native CPU EP; unlocks fp16/fp32 and is faster (needs the image built with
#        ORT_NODE_VARIANT=cpu or cuda, which is the default)
# cuda = native CUDA EP; see the GPU block at the bottom of docker-compose.yml
#PARAKEET_ORT=wasm
# Inference threads (0 = let ORT decide). SET IT to CPU_LIMIT: ORT sizes its pool
# from the HOST core count, which a container CPU quota does not change, so 0
# oversubscribes (12 threads sharing 4 CPUs of quota is slower than 4).
#PARAKEET_THREADS=0
# ffmpeg binary used to decode uploads. Empty = auto-detect (the image installs it).
#PARAKEET_FFMPEG=

# ─────────────────────────────────────────────────────────────────────────────
# 5. decoding
# ─────────────────────────────────────────────────────────────────────────────
# 1 = greedy (fastest). >1 runs MAES beam search: beam 8 measurably beats greedy
# on real audio, at a real CPU cost. Request field: beam_size (or beam_width).
#PARAKEET_BEAM_WIDTH=1
#PARAKEET_MAES_NUM_STEPS=2
#PARAKEET_MAES_EXPANSION_BETA=2
#PARAKEET_MAES_EXPANSION_GAMMA=2.3
#PARAKEET_MAES_PREFIX_ALPHA=0
#PARAKEET_BEAM_PREFETCH=true
# Decimate encoder frames before decoding: 1 = lossless, >1 trades accuracy for speed.
#PARAKEET_FRAME_STRIDE=1
# Does NOT change the transcript (greedy argmax is scale-invariant); it only
# rescales the reported confidences. At 0 every confidence is exactly 1.0 and
# verbose_json's avg_logprob is therefore 0 -- set 0.3-0.5 if you want meaningful
# confidence numbers back.
#PARAKEET_TEMPERATURE=0
# Chunking for long audio. Quality degrades badly without it.
#PARAKEET_CHUNKING=true
# Chunk seconds (allowed 10-90). Larger windows measured better on long audio
# (each seam costs a little); the max only bounds attention memory.
#PARAKEET_CHUNK_DURATION=60
#PARAKEET_OVERLAP=2
# Pull each chunk seam back to the quietest point within N seconds, so seams land
# in pauses instead of mid-word. 0 disables.
#PARAKEET_SNAP_TO_SILENCE=1

# ─────────────────────────────────────────────────────────────────────────────
# 6. phrase boosting
# ─────────────────────────────────────────────────────────────────────────────
# In-container wordlist directory (change only with the volume mount).
#PARAKEET_WORDLIST_DIR=/wordlists
# Wordlist used when a request names none (basename, no extension). A request can
# pick another with `phrase_boost=<name>`, or none with `phrase_boost=`.
#PARAKEET_WORDLIST=
# Inline default phrases, "phrase:WEIGHT:MINP:FLAG" comma/newline separated. This
# is also where a request's OpenAI `prompt` field lands: parakeet has no text
# conditioning, so a prompt is read as phrases to boost.
#PARAKEET_PROMPT=
# Multiplier over every phrase weight (0 disables boosting entirely).
#PARAKEET_BOOST_STRENGTH=1
# Override the min-p gate of EVERY phrase; empty = each phrase keeps its own.
#PARAKEET_BOOST_MINP=
# Trie depth-scaling; empty = built-in default. Baked in at build time, so a
# per-request value rebuilds the trie (slow on big lists).
#PARAKEET_DEPTH_SCALING=

# ─────────────────────────────────────────────────────────────────────────────
# 7. output shaping
# ─────────────────────────────────────────────────────────────────────────────
# json | text | srt | vtt | verbose_json (per request: response_format)
#PARAKEET_RESPONSE_FORMAT=json
# Echoed back in verbose_json and validated against the model's supported set. It
# does NOT force a language: parakeet-tdt v3 is multilingual and detects it.
#PARAKEET_LANGUAGE=
# Soft cap on segment/subtitle length, and the pause that starts a new segment.
#PARAKEET_MAX_SEGMENT_CHARS=180
#PARAKEET_SEGMENT_GAP_SEC=0.8

# ─────────────────────────────────────────────────────────────────────────────
# 8. diarization (speaker labels -- a documented extension, not part of the OpenAI API)
# ─────────────────────────────────────────────────────────────────────────────
# Needs TWO extra models in MODEL_DIR (or set the paths below):
#   model.onnx                  pyannote segmentation
#     hf download csukuangfj/sherpa-onnx-pyannote-segmentation-3-0
#   *campplus*.onnx             CAM++ speaker embeddings
#     hf download csukuangfj/speaker-embedding-models
# The engine itself (sherpa-onnx wasm) is vendored in the repo; nothing to fetch.
# true = diarize by default; otherwise send diarize=true per request.
#PARAKEET_DIARIZE=false
#PARAKEET_DIARIZE_SEG_MODEL=
#PARAKEET_DIARIZE_EMB_MODEL=
# Diarization threads (it is the dominant cost on long audio).
#PARAKEET_DIARIZE_THREADS=1
# Exact speaker count; -1 = cluster automatically with the threshold below.
#PARAKEET_NUM_SPEAKERS=-1
# Lower = more speakers.
#PARAKEET_DIARIZE_THRESHOLD=0.5
#PARAKEET_MIN_DURATION_ON=0.3
#PARAKEET_MIN_DURATION_OFF=0.5

# ─────────────────────────────────────────────────────────────────────────────
# 9. behaviour
# ─────────────────────────────────────────────────────────────────────────────
# true = 400 on any request that tries to override a decoding knob, so every
# transcript from this instance was produced with identical settings.
#PARAKEET_LOCK_PARAMS=false
# true = downgrade unsupported whisper flags/fields (translate, best_of, max_len,
# offset_t, ...) from an error to a warning, for drop-in use with clients that
# always send them. The transcript then does NOT honour them.
#PARAKEET_IGNORE_UNSUPPORTED=false
# Per-stage model and chunk timing logs.
#PARAKEET_VERBOSE=false

# ─────────────────────────────────────────────────────────────────────────────
# 10. build and container resources (read by docker-compose.yml, not the server)
# ─────────────────────────────────────────────────────────────────────────────
# Which onnxruntime-node backends to bake in:
#   none = wasm only (zero npm dependencies, smallest image)
#   cpu  = also PARAKEET_ORT=node (default, ~21 MB of .so)
#   cuda = also PARAKEET_ORT=cuda (+273 MB, and needs a CUDA base image)
#ORT_NODE_VARIANT=cpu
# Fail the build on any high-severity npm advisory.
#RUN_NPM_AUDIT=true
# Base image, pinned by digest in the Dockerfile. Override only for a CUDA base
# that already carries Node 22 + CUDA 12 + cuDNN 9.
#RUNTIME_BASE=
# Container limits. The int8 model needs ~1.5-2 GB resident; fp16 needs ~3 GB and
# fp32 ~5 GB, so raise MEMORY_LIMIT before switching precision.
#CPU_LIMIT=2.0
#MEMORY_LIMIT=4G
# /tmp is a tmpfs holding one upload at a time plus the diarization bootstrap.
# Keep it above PARAKEET_MAX_UPLOAD_MB.
#TMPFS_SIZE=256m
